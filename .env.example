# ═══════════════════════════════════════════════════════════════════
# F.R.I.D.A.Y. — Framework for Running Intelligent Deployed Agents
# Environment configuration
#
# Copy to .env.local and fill in what you need. EVERYTHING IS OPTIONAL —
# the recommended way to configure paths/keys is the /setup page, which
# writes data/config.json (local-only, gitignored). Env vars set here
# OVERRIDE data/config.json.
#
# Precedence: env var  >  data/config.json  >  built-in default
# ═══════════════════════════════════════════════════════════════════

# ── Branding ─────────────────────────────────────────────────────────
# UI brand name (safe for the browser — contains no secrets).
#NEXT_PUBLIC_APP_NAME=F.R.I.D.A.Y.

# ── Security (recommended if you expose the port beyond localhost) ──
# Bearer token required for API routes that write to disk
# (/api/setup, /api/pipeline POST, /api/approvals POST).
# When unset, writes are limited to loopback requests.
#INTERNAL_API_SECRET=

# Shared secret for agent heartbeat POSTs (/api/agents/*).
#AGENT_SECRET=

# ── Keys (server-side only; never sent to the browser) ──────────────
# OpenRouter key → live billing panel on the Costs tab.
#OPENROUTER_API_KEY=

# ── Core paths (usually set via /setup instead) ─────────────────────
# Base directory that default agent paths hang off (default: your home dir).
#MC_HOME=

# Multi-agent kanban SQLite DB (Hermes-compatible schema).
#MC_HERMES_KANBAN_DB=

# Web-dev pipeline store dir: pipeline.json + events.jsonl
# (default: <project>/data/pipeline).
#MC_PIPELINE_DIR=

# Additional path overrides — same keys exist in data/config.json:
#FRIDAY_AGENTS_DIR=          # per-agent session stores (+ usage JSONL for Costs)
#FRIDAY_WORKSPACE_DIR=       # agent workspace: MEMORY.md, ideas.json, checklists
#FRIDAY_PROJECT_WORKSPACE_DIR=
#FRIDAY_REPO_DIR=            # a local repo to surface in Projects
#FRIDAY_VAULT_DIR=           # notes vault (e.g. Obsidian); blank = disabled
#FRIDAY_PROJECT_VAULT_DIR=
#FRIDAY_USAGE_LOGS_DIR=
#FRIDAY_INBOX_DIR=
#FRIDAY_CRON_JOBS_FILE=      # scheduler jobs.json
#FRIDAY_GATEWAY_STATE_FILE=  # gateway state probed for system health
#FRIDAY_ML_CONTENT_DIR=      # ML content ideas (week-N.json)
#FRIDAY_EVENTBUS_ENV_FILE=   # env file holding EVENTBUS_TOKEN
#FRIDAY_PROVIDER_ENV_FILE=   # env file with a fallback OPENROUTER_API_KEY
#FRIDAY_GCAL_CREDS_FILE=     # Google Calendar service-account JSON
#FRIDAY_OPENCLAW_CONFIG=

# ── GitHub panel ─────────────────────────────────────────────────────
# Requires the `gh` CLI to be authenticated on this machine.
#FRIDAY_GITHUB_USER=         # username for the contributions heatmap
#FRIDAY_GITHUB_REPO=         # owner/name pinned on the Projects page

# ── Local services (liveness probes + SSE event bus) ────────────────
#MC_EVENTBUS_URL=http://127.0.0.1:9130/events
#EVENTBUS_TOKEN=             # bearer token for the event bus, if it needs one
#FRIDAY_OPENCLAW_URL=http://127.0.0.1:18789/
#FRIDAY_OLLAMA_URL=http://127.0.0.1:11434/api/version
#FRIDAY_LLMSTER_URL=http://127.0.0.1:1234/v1/models

# ── Misc ─────────────────────────────────────────────────────────────
# Remote ingestion API used by lib/ingestion-client (optional).
#INGESTION_API_URL=

# Dev-server origin allowlist (LAN/VPN IPs), comma-separated
#FRIDAY_DEV_ORIGINS=
